<?xml version="1.0"?>

<sdf version="1.8">

  <model name="robotic_arm">

    <!-- ================= BASE ================= -->

    <link name="base">

      <pose>0 0 0.15 0 0 0</pose>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>

    </link>


    <!-- ================= LOWER ARM ================= -->

    <link name="link1">

      <pose>0 0 0.65 0 0 0</pose>

      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <visual name="link1_visual">
        <geometry>
          <box>
            <size>0.18 0.18 0.8</size>
          </box>
        </geometry>
      </visual>

      <collision name="link1_collision">
        <geometry>
          <box>
            <size>0.18 0.18 0.8</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ================= UPPER ARM ================= -->

    <link name="link2">

      <pose>0 0 1.15 0 0 0</pose>

      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>

      <visual name="link2_visual">
        <geometry>
          <box>
            <size>0.16 0.16 0.6</size>
          </box>
        </geometry>
      </visual>

      <collision name="link2_collision">
        <geometry>
          <box>
            <size>0.16 0.16 0.6</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ================= GRIPPER ================= -->

    <link name="gripper">

      <pose>0 0 1.5 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="gripper_visual">
        <geometry>
          <box>
            <size>0.3 0.2 0.1</size>
          </box>
        </geometry>
      </visual>

      <collision name="gripper_collision">
        <geometry>
          <box>
            <size>0.3 0.2 0.1</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ================= LEFT FINGER ================= -->

    <link name="left_finger">

      <pose>0 0.13 1.35 0 0 0</pose>

      <visual name="left_finger_visual">
        <geometry>
          <box>
            <size>0.1 0.06 0.25</size>
          </box>
        </geometry>
      </visual>

      <collision name="left_finger_collision">
        <geometry>
          <box>
            <size>0.1 0.06 0.25</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ================= RIGHT FINGER ================= -->

    <link name="right_finger">

      <pose>0 -0.13 1.35 0 0 0</pose>

      <visual name="right_finger_visual">
        <geometry>
          <box>
            <size>0.1 0.06 0.25</size>
          </box>
        </geometry>
      </visual>

      <collision name="right_finger_collision">
        <geometry>
          <box>
            <size>0.1 0.06 0.25</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ================= JOINTS ================= -->

    <joint name="joint1" type="revolute">

      <parent>base</parent>
      <child>link1</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
          <effort>30</effort>
          <velocity>2</velocity>
        </limit>

        <dynamics>
          <damping>3</damping>
        </dynamics>

      </axis>

    </joint>


    <joint name="joint2" type="revolute">

      <parent>link1</parent>
      <child>link2</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
          <effort>30</effort>
          <velocity>2</velocity>
        </limit>

        <dynamics>
          <damping>3</damping>
        </dynamics>

      </axis>

    </joint>


    <joint name="gripper_joint" type="fixed">

      <parent>link2</parent>
      <child>gripper</child>

    </joint>


    <joint name="left_finger_joint" type="revolute">

      <parent>gripper</parent>
      <child>left_finger</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>

      </axis>

    </joint>


    <joint name="right_finger_joint" type="revolute">

      <parent>gripper</parent>
      <child>right_finger</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>

      </axis>

    </joint>


    <!-- ================= CONTROLLERS ================= -->

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>joint1</joint_name>
      <topic>/arm/joint1</topic>

    </plugin>


    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>joint2</joint_name>
      <topic>/arm/joint2</topic>

    </plugin>


    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>left_finger_joint</joint_name>
      <topic>/arm/left_finger</topic>

    </plugin>


    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">

      <joint_name>right_finger_joint</joint_name>
      <topic>/arm/right_finger</topic>

    </plugin>

  </model>

</sdf>
