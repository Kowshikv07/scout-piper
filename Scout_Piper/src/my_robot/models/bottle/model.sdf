<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="bottle">
    <!-- Origin at the base of the bottle. Spawn with z = 0.001 -->
    <link name="bottle_link">

      <!-- 500 ml of liquid + ~25 g PET. CoM about 7.5 cm up. -->
      <inertial>
        <pose>0 0 0.075 0 0 0</pose>
        <mass>0.53</mass>
        <inertia>
          <ixx>0.00113</ixx><iyy>0.00113</iyy><izz>0.00027</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- ============ COLLISION (simple primitives = stable physics) ============ -->
      <collision name="body_collision">
        <pose>0 0 0.0525 0 0 0</pose>
        <geometry><cylinder><radius>0.0315</radius><length>0.105</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>100000</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
      <collision name="shoulder_collision">
        <pose>0 0 0.1300 0 0 0</pose>
        <geometry><cylinder><radius>0.0245</radius><length>0.050</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <collision name="neck_collision">
        <pose>0 0 0.1780 0 0 0</pose>
        <geometry><cylinder><radius>0.0150</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>

      <!-- ============ VISUALS ============ -->

      <!-- Clear PET shell, faint green tint -->
      <visual name="body_visual">
        <geometry><mesh><uri>meshes/bottle_body.obj</uri></mesh></geometry>
        <material>
          <ambient>0.80 0.95 0.85 1</ambient>
          <diffuse>0.80 0.95 0.85 1</diffuse>
          <specular>1.0 1.0 1.0 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.05</roughness>
          </metal></pbr>
        </material>
        <transparency>0.70</transparency>
      </visual>

      <!-- Liquid -->
      <visual name="liquid_visual">
        <geometry><mesh><uri>meshes/bottle_liquid.obj</uri></mesh></geometry>
        <material>
          <ambient>0.90 1.00 0.90 1</ambient>
          <diffuse>0.90 1.00 0.90 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
        <transparency>0.80</transparency>
      </visual>

      <!-- Paper/plastic label with texture -->
      <visual name="label_visual">
        <geometry><mesh><uri>meshes/bottle_label.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/label.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>0.5</roughness>
          </metal></pbr>
        </material>
      </visual>

      <!-- Green knurled cap -->
      <visual name="cap_visual">
        <geometry><mesh><uri>meshes/bottle_cap.obj</uri></mesh></geometry>
        <material>
          <ambient>0.0 0.55 0.20 1</ambient>
          <diffuse>0.0 0.60 0.22 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr><metal>
            <metalness>0.0</metalness>
            <roughness>0.35</roughness>
          </metal></pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
