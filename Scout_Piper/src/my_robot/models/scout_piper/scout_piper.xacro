<?xml version="1.0"?>

<robot name="scout_piper" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- ====================================================== -->
    <!-- Scout Mini                                             -->
    <!-- ====================================================== -->

    <link name="scout_base_link">

        <visual>
            <origin xyz="0.015 0.023131665 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/kowshik0714/ros2_ws/src/ugv_gazebo_sim/scout/scout_description/meshes/scout_mini_base_link.STL"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0.015 0.023131665 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file:///home/kowshik0714/ros2_ws/src/ugv_gazebo_sim/scout/scout_description/meshes/scout_mini_base_link.STL"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.015 0.023131665 0"/>
            <mass value="132.3898489950015"/>
            <inertia
                ixx="0.185196122711036"
                ixy="4.30144213829512E-08"
                ixz="5.81037523686401E-08"
                iyy="0.364893736238929"
                iyz="-0.000386720198091934"
                izz="0.223868521722778"/>
        </inertial>

    </link>


    <!-- ====================================================== -->
    <!-- Scout wheels                                           -->
    <!-- ====================================================== -->

    <xacro:macro name="scout_wheel" params="name x y rpy axis_z">

        <link name="${name}_wheel_link">

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file:///home/kowshik0714/ros2_ws/src/ugv_gazebo_sim/scout/scout_description/meshes/wheel.dae"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="0 0 0.03" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.08" length="0.084"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0"/>
                <mass value="3"/>
                <inertia
                    ixx="0.006564"
                    ixy="0"
                    ixz="0"
                    iyy="0.006564"
                    iyz="0"
                    izz="0.0096"/>
            </inertial>

        </link>

        <joint name="${name}_wheel" type="continuous">

            <parent link="scout_base_link"/>
            <child link="${name}_wheel_link"/>

            <origin xyz="${x} ${y} -0.077" rpy="${rpy}"/>

            <axis xyz="0 0 ${axis_z}"/>

        </joint>

    </xacro:macro>


    <xacro:scout_wheel
        name="front_left"
        x="0.1566278"
        y="0.2281768"
        rpy="-1.57 0 0"
        axis_z="1"/>

    <xacro:scout_wheel
        name="rear_left"
        x="-0.1566278"
        y="0.2281768"
        rpy="-1.57 0 0"
        axis_z="1"/>

    <xacro:scout_wheel
        name="front_right"
        x="0.1566278"
        y="-0.2281768"
        rpy="1.57 0 0"
        axis_z="-1"/>
    <!-- Scout differential drive -->
<link name="camera_link">
    <visual>
        <geometry>
            <box size="0.05 0.05 0.03"/>
        </geometry>
    </visual>
    <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
    </inertial>
</link>

<joint name="camera_joint" type="fixed">
    <parent link="scout_base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.35" rpy="0 0.35 0"/>
</joint>

<gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>

        <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R_FLOAT32</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>8.0</far>
            </clip>
        </camera>
        <topic>/camera/depth</topic>
    </sensor>
</gazebo>
<!-- RGB camera -->
<gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>

        <camera>
            <horizontal_fov>1.047</horizontal_fov>

            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>

            <clip>
                <near>0.1</near>
                <far>8.0</far>
            </clip>
        </camera>

        <topic>/camera/image</topic>
    </sensor>
</gazebo>
<!-- Scout differential drive -->
<gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>front_left_wheel</left_joint>
        <left_joint>rear_left_wheel</left_joint>

        <right_joint>front_right_wheel</right_joint>
        <right_joint>rear_right_wheel</right_joint>

        <wheel_separation>0.456</wheel_separation>
        <wheel_radius>0.08</wheel_radius>

        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>scout_base_link</child_frame_id>
    </plugin>
</gazebo>
    <xacro:scout_wheel
        name="rear_right"
        x="-0.1566278"
        y="-0.2281768"
        rpy="1.57 0 0"
        axis_z="-1"/>


    <!-- ====================================================== -->
    <!-- Piper                                                   -->
    <!-- ====================================================== -->

    <xacro:include filename="$(find piper_description)/urdf/piper_macro.xacro"/>

    <xacro:load_piper
        parent="scout_base_link"
        prefix=""
        sim_gazebo="true"
        mock_hardware="false">

        <!-- Piper mounted on top of Scout -->
        <origin
            xyz="0 0 0.12"
            rpy="0 0 0"/>

    </xacro:load_piper>


    <!-- ====================================================== -->
    <!-- Piper Gazebo ROS 2 Control Plugin                      -->
    <!-- ====================================================== -->

    <gazebo>

        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>
                /home/kowshik0714/ros2_ws/src/piper_ros2/piper_description/config/gz_controllers.yaml
            </parameters>

            <controller_manager_node_name>
                controller_manager
            </controller_manager_node_name>

        </plugin>

    </gazebo>

</robot>
