<?xml version="1.0" ?>

<sdf version="1.10">
  <world name="scout_world">

    <physics name="1ms" type="gz.sim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>

	<visual name="visual">
	  <geometry>
	    <plane>
	      <normal>0 0 1</normal>
	      <size>50 50</size>
	    </plane>
	  </geometry>
	
	  <material>
	    <ambient>0.8 0.8 0.8 1</ambient>
	    <diffuse>0.9 0.9 0.9 1</diffuse>
	    <specular>0.05 0.05 0.05 1</specular>
	    <emissive>0.05 0.05 0.05 1</emissive>
	  </material>
	</visual>
      </link>
    </model>

  
  <include>
    <uri>file:///home/kowshik0714/ros2_ws/src/my_robot/models/dustbin/model.sdf</uri>
    <name>dustbin</name>
    <pose>4.0 0.0 0 0 0 0</pose>
  </include>

    <!-- ========================================================= -->
    <!-- SEMINAR HALL DESK OBSTACLES                               -->
    <!-- ========================================================= -->

    <model name="desk_obstacle_1">
      <static>true</static>
      <pose>2.0 1.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.6 0.7 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.6 0.7 0.9</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="desk_obstacle_2">
      <static>true</static>
      <pose>0.5 -1.6 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 0.7 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.8 0.7 0.9</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="desk_obstacle_3">
      <static>true</static>
      <pose>3.4 1.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.9</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="desk_obstacle_4">
      <static>true</static>
      <pose>3.0 -1.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 0.7 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 0.7 0.9</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

</world>
</sdf>
