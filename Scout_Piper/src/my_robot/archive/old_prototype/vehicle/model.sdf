<?xml version="1.0"?>
<sdf version="1.8">
  <model name="vehicle">
    <self_collide>false</self_collide>
    <!-- Chassis -->
    <link name="chassis">
      <pose>0 0 0.35 0 0 0</pose>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.8</ixx>
          <iyy>1.8</iyy>
          <izz>2.0</izz>
        </inertia>
      </inertial>

      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>
      </visual>

      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>
      </collision>
<sensor name="lidar" type="gpu_lidar">
  <pose>0.8 0 0.35 0 0 3.14159</pose>
  <topic>/scan</topic>
  <update_rate>10</update_rate>

  <ray>
    <scan>
      <horizontal>
        <samples>360</samples>
        <resolution>1</resolution>
        <min_angle>-3.14159</min_angle>
        <max_angle>3.14159</max_angle>
      </horizontal>
    </scan>

    <range>
      <min>0.12</min>
      <max>10.0</max>
      <resolution>0.01</resolution>
    </range>
  </ray>

  <always_on>true</always_on>
  <visualize>true</visualize>
</sensor>
<!-- LiDAR coverage visualization -->
<visual name="lidar_coverage">
  <pose>0.8 0 0.35 0 0 0</pose>
  <geometry>
    <cylinder>
      <radius>5.0</radius>
      <length>0.01</length>
    </cylinder>
  </geometry>
  <material>
    <ambient>0.0 1.0 0.0 0.3</ambient>
    <diffuse>0.0 1.0 0.0 0.3</diffuse>
    <specular>0.0 1.0 0.0 0.1</specular>
    <transparency>0.7</transparency>
  </material>
</visual>
      <sensor name="camera" type="camera">
        <pose>1.0 0 0.4 0 0 0</pose>
        <topic>/camera/image</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>0.55</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>15</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

    </link>

    <!-- Left wheel -->

    <link name="left_wheel">
      <pose>0 0.65 0.3 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>

      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right wheel -->
    <link name="right_wheel">
      <pose>0 -0.65 0.3 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>

      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Left wheel joint -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Right wheel joint -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Differential drive -->
<plugin
  filename="gz-sim-diff-drive-system"
  name="gz::sim::systems::DiffDrive">

  <left_joint>left_wheel_joint</left_joint>
  <right_joint>right_wheel_joint</right_joint>

  <wheel_separation>1.3</wheel_separation>
  <wheel_radius>0.3</wheel_radius>

  <topic>/model/vehicle/cmd_vel</topic>

  <odom_topic>/model/vehicle/odometry</odom_topic>
  <frame_id>vehicle/odom</frame_id>
  <child_frame_id>vehicle/chassis</child_frame_id>

</plugin>

<!-- Arm shoulder -->
<link name="arm_shoulder">
  <pose>0.5 0 0.65 0 0 0</pose>
  <inertial>
    <mass>0.3</mass>
    <inertia>
      <ixx>0.002</ixx>
      <iyy>0.002</iyy>
      <izz>0.002</izz>
    </inertia>
  </inertial>
  <visual name="arm_shoulder_visual">
    <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
  </visual>
  <collision name="arm_shoulder_collision">
    <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
  </collision>
</link>

<joint name="shoulder_joint" type="revolute">
  <parent>chassis</parent>
  <child>arm_shoulder</child>
  <axis>
    <xyz>0 1 0</xyz>
    <limit><lower>-0.2</lower><upper>1.9</upper></limit>
  </axis>
</joint>

<!-- Forearm / gripper -->
<link name="arm_forearm">
  <pose>1.0 0 0.5 0 0 0</pose>
  <inertial>
    <mass>0.2</mass>
    <inertia>
      <ixx>0.002</ixx>
      <iyy>0.002</iyy>
      <izz>0.002</izz>
    </inertia>
  </inertial>
  <visual name="arm_forearm_visual">
    <geometry><box><size>1.0 0.12 0.12</size></box></geometry>
  </visual>
  <collision name="arm_forearm_collision">
    <geometry><box><size>1.0 0.12 0.12</size></box></geometry>
  </collision>
</link>

<joint name="elbow_joint" type="revolute">
  <parent>arm_shoulder</parent>
  <child>arm_forearm</child>
  <axis>
    <xyz>0 1 0</xyz>
    <limit><lower>-0.3</lower><upper>1.6</upper></limit>
  </axis>
</joint>

  <!-- Shoulder position controller -->
  <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
    <joint_name>shoulder_joint</joint_name>
    <topic>/model/vehicle/shoulder_cmd</topic>
    <p_gain>5.0</p_gain>
    <d_gain>0.2</d_gain>
    <cmd_max>10</cmd_max>
    <cmd_min>-10</cmd_min>
  </plugin>

  <!-- Elbow position controller -->
  <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
    <joint_name>elbow_joint</joint_name>
    <topic>/model/vehicle/elbow_cmd</topic>
    <p_gain>5.0</p_gain>
    <d_gain>0.2</d_gain>
    <cmd_max>10</cmd_max>
    <cmd_min>-10</cmd_min>
  </plugin>

  <!-- Grab/hold -->
<!--
  <plugin filename="gz-sim-detachable-joint-system"
          name="gz::sim::systems::DetachableJoint">
    <parent_link>arm_forearm</parent_link>
    <child_model>bottle1</child_model>
    <child_link>bottle_link</child_link>
    <attach_topic>/attach</attach_topic>
    <detach_topic>/detach</detach_topic>
  </plugin>
-->
</model>
</sdf>
